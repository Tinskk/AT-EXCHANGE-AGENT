# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Not read by any script here — kept for reference when managing message
# templates / the number in Meta Business Suite.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
GRAPH_API_VERSION=v21.0

# --- Owner / staff ---
# Comma-separated WhatsApp numbers (Meta's "from" format — digits only, no
# "+", no spaces, e.g. "2348012345678"). Messages from these numbers are
# treated as staff commands (confirm/reject/complete/setrate), never as
# customer chat.
OWNER_WHATSAPP_NUMBERS=

# --- App ---
BUSINESS_NAME=AT Exchange
# Optional locally — defaults to app/data/agent.db relative to app/'s own
# location, which is correct regardless of the process's working directory.
# On Render, app/render.yaml sets this to /var/data/agent.db automatically,
# pointing at the persistent disk so leads survive redeploys. Only set this
# yourself if you need the SQLite file somewhere else.
# AGENT_DB_PATH=
